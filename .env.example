# ════════════════════════════════════════════════════════════════════════
#  TRAIDER — global configuration (.env)
#
#  Settings live in THREE layers, and this file is only the GLOBAL one: what this
#  machine has, not what a strategy wants.
#
#    .env                        → global   (this file)
#    data/account/account.json   → account  (🏦 Account Settings)
#    data/strategies/store.json  → strategy (Strategy Configuration panel)
#
#  Precedence at runtime: strategy > account > .env > schema default.
#
#  Every STRATEGY setting — instrument, bar size, period, feature toggles and their
#  periods, the risk numbers, the backtest gates — lives in the strategy layer, and
#  this file does not duplicate them: store.json is their single source. A new
#  strategy is seeded from the active strategy's values, or from the schema defaults
#  on a fresh install.
#
#  Nothing writes this file: it is edited by hand. An unknown key here is ignored
#  rather than an error.
# ════════════════════════════════════════════════════════════════════════

# The two JSON stores the app keeps its own state in: every strategy's settings
# in the first, the account's (broker, folders, backtest defaults) in the second.
STRATEGY_RULES_FILE=data/strategies/store.json
ACCOUNT_SETTINGS_FILE=data/account/account.json

# One provider only: yfinance (config/history.DATA_PROVIDER). The premium
# fallbacks were removed — they need keys nobody has, and a chain that ends in
# "Missing credential" buries the real error. This caches the candles it returns.
DATA_CACHE_ENABLED=True
CACHE_DIR=.cache

# FLOOR, not a window: the live fetch never asks for fewer days than the configured
# features need. Raise it to tolerate a missed run; lowering it below the warmup
# changes nothing.
LIVE_LOOKBACK_DAYS=10

# Costs applied to every fill.
BACKTEST_SLIPPAGE_PERCENT=0.05
BACKTEST_COMMISSION_PER_TRADE=0.0

# There is no MODEL_TYPE: rule_based is the only model that exists, so the kind of
# model is a constant in the code (``src/model/simple_model.MODEL_KIND``) rather than
# a switch with one position. The thresholds below still gate a fired rule — a signal
# acts only when the rule's confidence clears its side's threshold.
MODEL_BUY_THRESHOLD=0.6
MODEL_SELL_THRESHOLD=0.6

# Retry policy for a refused order.
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BASE_DELAY_SECONDS=1
EXECUTION_ORDER_TIMEOUT_SECONDS=60