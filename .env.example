# ════════════════════════════════════════════════════════════════════════
#  TRAIDER — Global configuration (.env)
#
#  Settings live in THREE layers, and this file is only the GLOBAL one: how this
#  machine reaches the outside world (the data provider and its keys) plus the
#  paths of the two JSON stores. Edit it HERE — the dashboard has no form for it.
#
#    .env                             → global   (this file)
#    settings/account/account.json    → account  (🏦 Account Settings popup)
#    settings/strategies/store.json   → strategy (Strategy Configuration panel)
#
#  Precedence at runtime: strategy > account > .env > schema default. The keys
#  below that now belong to another layer are kept as FALLBACKS: they seed a
#  brand-new account/strategy and are normally edited in the portal popups.
#
#  Copy to `.env` and fill in. Secrets go to AWS Secrets Manager in prod.
# ════════════════════════════════════════════════════════════════════════

# ── Layer files (internal — normally leave as-is) ──────────────────────
# Where the account and strategy layers are persisted. These paths, together
# with the data folders they refer to, are the only things the app needs to
# find its own state. The data folder itself is set in 🏦 Account Settings
# (DATA_DIR), which drives <DATA_DIR>/historical and <DATA_DIR>/backtest_results.
STRATEGY_RULES_FILE=settings/strategies/store.json
ACCOUNT_SETTINGS_FILE=settings/account/account.json

# ── Trading instrument & trading period ────────────────────────────────
# The stock the strategy operates on (any listed equity ticker).
INSTRUMENT=AAPL

# There is no decision-cadence setting: a decision is made on EVERY newly generated
# bar. The signal for a bar is computed at that bar's close and filled at the next
# bar's open, so what limits the cadence is the bar size (HISTORICAL_BAR_SIZE) and the
# trading window below.

# The session, in 24h exchange-local time. It bounds DECISIONS, not just the poll: a
# bar whose own time is outside it produces no signal (a 09:30-16:00 session means a
# pre-market or after-hours bar is never acted on, and neither is a weekend one).
# Daily bars are exempt — a daily bar IS a session, so there is no clock time to
# compare. The end is also when a daily bar becomes final for the delta.
TRADING_START_HOUR=09:30
TRADING_END_HOUR=16:00
# Timezone of the exchange where the symbol trades (all HH:MM times are local to it).
MARKET_TIMEZONE=America/New_York

# Clock time (HH:MM, exchange-local) the completed daily bar is pulled into the
# historical dataset (the "daily delta"). Should be shortly AFTER market close.
DATA_DELTA_PULL_TIME=16:30

# ── Market data (OpenBB Platform SDK) ──────────────────────────────────
# OpenBB aggregates market data providers. Free providers (yfinance) need
# no key; premium providers (polygon, fmp, intrinio, ...) require OPENBB_API_KEY.
OPENBB_PROVIDER=yfinance
# OPENBB_API_KEY=
# Comma-separated fallback providers tried if the primary fails.
OPENBB_BACKUP_PROVIDERS=yfinance,polygon,fmp
# Local caching of fetched candles (off/on).
DATA_CACHE_ENABLED=True
CACHE_DIR=.cache

# ── Historical data period (backtest & model training) ─────────────────
# Bar size for fetched candles: 1m, 2m, 5m, 15m, 1h, 2h, 4h, 8h, 12h or 1d.
# Default: daily bars. Each bar size limits how far back the data can reach —
# see HISTORICAL_LOOKBACK below.
HISTORICAL_BAR_SIZE=1d
# How much history to fetch, counted back from now: <N>y years or <N>d days
# ("2y", "30d"; a bare number still means years). Which periods are usable
# depends on HISTORICAL_BAR_SIZE — the provider only serves intraday bars for a
# short trailing window, so minute bars reach days and daily bars reach years:
#   1m                 -> 15d, 30d
#   2m, 5m, 15m        -> 30d, 60d
#   1h, 2h             -> 1y, 2y
#   4h, 8h, 12h        -> 1y, 2y, 3y
#   1d                 -> 2y, 3y, 4y, 5y
# Usually set per strategy in the dashboard (Instrument group), not here.
HISTORICAL_LOOKBACK=2y
# Date range of historical data to fetch (YYYY-MM-DD). Empty = all available.
# Only used when HISTORICAL_LOOKBACK is empty — the period is the normal answer.
HISTORICAL_START_DATE=2022-01-01
HISTORICAL_END_DATE=
# Backtest window (empty = reuse HISTORICAL_START/END_DATE).
BACKTEST_START_DATE=
BACKTEST_END_DATE=
# Fraction of data used to train the model (remainder is validation).
TRAIN_TEST_SPLIT=0.8
# Lookback window (days) fetched by the daily live poll. Should be >= the
# longest indicator window (FEATURES_MIN_LOOKBACK) so features can compute;
# a bit extra also tolerates missed runs.
LIVE_LOOKBACK_DAYS=10
# Canonical dataset directory (Parquet, one file per symbol/interval) that
# backtesting and model training read. Leave UNSET: it is derived as
# <DATA_DIR>/historical, where DATA_DIR is set in 🏦 Account Settings.
# HISTORICAL_DATA_DIR=data/historical
# Optional S3 sync: local dataset is written first, then uploaded to S3 as the
# durable source of truth (restored if the instance is rebuilt). Enable at deploy.
S3_ENABLED=False
S3_BUCKET=
S3_PREFIX=traider/historical
# S3_ENDPOINT_URL=               # e.g. MinIO for local development

# ── Features (signal evaluation) ───────────────────────────────────────
# All indicator parameters that turn price → features. Kept identical
# between backtest and live. Comma-separated lists = multiple windows.
FEATURES_SMA_PERIODS=10,20,50
FEATURES_EMA_PERIODS=9,21,50
# MACD: fast and slow EMA windows plus the signal-line EMA window.
# FEATURES_MACD_FAST_PERIOD must be smaller than FEATURES_MACD_SLOW_PERIOD.
FEATURES_MACD_FAST_PERIOD=12
FEATURES_MACD_SLOW_PERIOD=26
FEATURES_MACD_SIGNAL_PERIOD=9
FEATURES_RSI_PERIOD=14
FEATURES_ATR_PERIOD=14
FEATURES_BOLLINGER_PERIOD=20
FEATURES_BOLLINGER_STD=2.0
FEATURES_MOMENTUM_PERIODS=10,20
FEATURES_VOLATILITY_PERIOD=20
FEATURES_VWAP_PERIOD=20
FEATURES_VOLUME_PERIOD=20
# Minimum lookback (warmup bars) required before emitting features.
FEATURES_MIN_LOOKBACK=50

# ── Feature toggles (on/off) ──────────────────────────────────────────
# Turn each indicator on or off independently (True/on = enabled, False/off = disabled).
FEATURE_SMA_ENABLED=True
FEATURE_EMA_ENABLED=True
FEATURE_MACD_ENABLED=True
FEATURE_RSI_ENABLED=True
FEATURE_ATR_ENABLED=True
FEATURE_BOLLINGER_ENABLED=True
FEATURE_MOMENTUM_ENABLED=True
FEATURE_VOLATILITY_ENABLED=True
FEATURE_VWAP_ENABLED=True
FEATURE_VOLUME_ENABLED=True
FEATURE_VOLUME_ABS_ENABLED=True

# ── Model (signal generator) ───────────────────────────────────────────
MODEL_TYPE=rule_based              # rule_based is the only implemented model;
                                   # logistic_regression is planned, not built
# A signal only acts when the model confidence meets/exceeds its threshold.
MODEL_BUY_THRESHOLD=0.6
MODEL_SELL_THRESHOLD=0.6
# How often to retrain the model (days).
MODEL_RETRAIN_INTERVAL_DAYS=30

# ── Risk management ────────────────────────────────────────────────────
# Every risk field is OPTIONAL, and EMPTY MEANS NOT APPLIED — in the backtest and
# in live/paper trading alike, because both read these same values. There is no
# master switch: what is set is applied, and what is empty is left out of the run.
# (Zero is not the same as empty: a 0% stop is a stop at the entry, and a 0% risk
# limit would size every position to nothing.)
MAX_EXPOSURE_PERCENT=100          # max % of account in one position; 100 = the whole account
RISK_LIMIT_PERCENT=               # % of account risked per trade, e.g. 2 (needs a stop)
STOP_LOSS_PERCENT=                # stop distance below the entry (%), e.g. 2
TAKE_PROFIT_PERCENT=              # target above the entry (%), e.g. 4
MAX_LOSS_PERCENT=                 # halt the day past this realised loss (%), e.g. 5
MAX_CONSECUTIVE_LOSSES=           # halt the day after N losing trades, e.g. 3
POSITION_SIZING_MODE=fixed_risk   # fixed_risk | volatility_target
# The last two are COLLECTED but not yet applied: halting on losses belongs to the
# execution loop, which is where the frequent decisions make a streak meaningful.

# ── Backtest quality gates (must pass before live) ─────────────────────
GATE_MIN_SHARPE=1.0
GATE_MAX_DRAWDOWN_PERCENT=25
GATE_MIN_WIN_RATE_PERCENT=55
GATE_MAX_WEEKLY_LOSS_PERCENT=5
BACKTEST_SLIPPAGE_PERCENT=0.05
BACKTEST_COMMISSION_PER_TRADE=0.0   # USD per side, or % if IS_PERCENT=True

# ── Execution (Alpaca) — used ONLY to place orders, data comes from OpenBB ──
# These credentials describe this ACCOUNT. Which ENVIRONMENT an order goes to
# (paper vs live) is per STRATEGY, so it lives in the strategy panel, not here.
# Switching is one base URL + key pair swap. See .github/skills/alpaca-execution
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BASE_DELAY_SECONDS=1
EXECUTION_ORDER_TIMEOUT_SECONDS=60

# ── Scheduler ──────────────────────────────────────────────────────────
SCHEDULER_ENABLED=True
SCHEDULER_TIMEZONE=America/New_York

# ── State storage (DynamoDB) ───────────────────────────────────────────
# Durable state/portfolio tracking. In prod, attach an IAM role to the
# instance/container — do NOT store AWS credentials here.
AWS_REGION=us-east-1
DYNAMODB_TABLE=traider-state
DYNAMODB_TTL_DAYS=30
# Optional: for local development (e.g. DynamoDB Local) set the endpoint URL.
DYNAMODB_ENDPOINT_URL=
# If you must use credentials for local testing, set them in your local env.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Web Portal (dashboard: progress, charts, configuration, alerts) ──
# Serves a web dashboard to monitor the bot. Uses FastAPI + uvicorn.
WEB_PORTAL_ENABLED=True
WEB_PORTAL_HOST=0.0.0.0
WEB_PORTAL_PORT=8000
WEB_PORTAL_AUTH_ENABLED=True
WEB_PORTAL_USERNAME=admin
# WEB_PORTAL_PASSWORD=             # secret — set locally / via Secrets Manager